# ===========================================
# PlateformK / Klassio - Variables d'environnement
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs
# cp .env.example .env

# ===========================================
# Configuration des ports
# ===========================================
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ===========================================
# Configuration PostgreSQL
# ===========================================
POSTGRES_DB=klassio
POSTGRES_USER=klassio
POSTGRES_PASSWORD=your_secure_password_here

# ===========================================
# Configuration Backend Spring Boot
# ===========================================
SPRING_PROFILES_ACTIVE=prod
BACKEND_IMAGE=klassio-backend:latest

# ===========================================
# Configuration JWT
# ===========================================
# IMPORTANT: Générez une clé secrète sécurisée (minimum 256 bits)
# Exemple: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ===========================================
# Configuration Redis (optionnel)
# ===========================================
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# Configuration Email (SMTP)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@klassio.com

# ===========================================
# Configuration Stripe (Paiements)
# ===========================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# Configuration Frontend Angular
# ===========================================
# URL de l'API backend (utilisé lors du build)
API_URL=http://localhost:8080/api/v1/

# ===========================================
# Configuration de développement
# ===========================================
# Activer le mode debug
DEBUG=false
LOG_LEVEL=info
