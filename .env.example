# ===========================================
# PlateformK / Klassio - Variables d'environnement (frontend)
# ===========================================
# NOTE : l'application Angular ne lit PAS ce fichier à l'exécution.
# L'URL de l'API est compilée dans les fichiers `src/environments/` :
#   - développement : src/environments/environment.development.ts
#   - production    : src/environments/environment.prod.ts
# Ce fichier sert de référence pour le déploiement (docker, CI, proxy).
# Copiez-le vers `.env` et adaptez les valeurs.

# ===========================================
# Ports
# ===========================================
FRONTEND_PORT=4200
BACKEND_PORT=8080

# ===========================================
# URL de l'API backend (référence pour build/reverse-proxy)
# ===========================================
API_URL=http://localhost:8080/api/v1/

# ===========================================
# Backend Spring Boot (rappel : MySQL, pas PostgreSQL)
# ===========================================
SPRING_PROFILES_ACTIVE=prod
BACKEND_IMAGE=klassio-backend:latest

# ===========================================
# JWT (backend)
# ===========================================
# Générer une clé sécurisée : openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION=604800000

# ===========================================
# Debug
# ===========================================
DEBUG=false
